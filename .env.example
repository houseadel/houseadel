# Client-visible mode label. Keep this aligned with the selected server provider.
# This value is public and must never contain a credential.
VITE_APPLICATION_MODE=mock

# Server-only application provider: mock, email, google-sheets, or disabled.
# Mock accepts in memory for local development and does not persist applicant data.
HOUSE_ADEL_APPLICATION_PROVIDER=mock

# Generic server-to-server email delivery webhook. Required only for provider=email.
HOUSE_ADEL_EMAIL_WEBHOOK_URL=
HOUSE_ADEL_EMAIL_WEBHOOK_TOKEN=

# Google Sheets append provider. Required only for provider=google-sheets.
# Share the target sheet with the service account before use.
HOUSE_ADEL_GOOGLE_SHEETS_ID=
HOUSE_ADEL_GOOGLE_SHEETS_RANGE=Applications!A:AC
HOUSE_ADEL_GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Cloudflare Turnstile. Configure both values together. The client
# widget renders only when the public site key exists; verification stays server-only.
VITE_TURNSTILE_SITE_KEY=
HOUSE_ADEL_TURNSTILE_SECRET_KEY=

# Trust X-Forwarded-For only behind a controlled reverse proxy.
HOUSE_ADEL_TRUST_PROXY=false

# Production source maps are disabled unless explicitly opted in.
HOUSE_ADEL_BUILD_SOURCEMAPS=false

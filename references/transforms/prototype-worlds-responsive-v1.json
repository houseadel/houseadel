{
  "schemaVersion": "0.1.0",
  "tool": "sharp",
  "toolVersion": "0.35.3",
  "operation": "auto-orient-resize-and-encode",
  "createdAt": "2026-07-30",
  "settings": {
    "fit": "inside",
    "withoutEnlargement": true,
    "widths": [480, 960, 1440],
    "formats": {
      "avif": {
        "quality": 55,
        "effort": 4,
        "chromaSubsampling": "4:2:0"
      },
      "webp": {
        "quality": 78,
        "effort": 4,
        "smartSubsample": true
      }
    }
  },
  "commandPattern": "node scripts/generate-responsive-images.mjs <master> --output-dir public/assets/worlds --name <asset-id> --widths 480,960,1440 --formats avif,webp --json"
}

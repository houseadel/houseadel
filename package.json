{
  "name": "house-adel",
  "version": "1.0.0",
  "private": true,
  "description": "House Adel, an independent web studio making art-directed websites.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js skills/house-adel-design-guardian/scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:serve": "node scripts/serve-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "capture:production": "npm run build && node scripts/capture-production-screenshots.mjs",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "measure:runtime": "node scripts/measure-runtime.mjs",
    "audit:performance": "npm run measure:runtime && node scripts/check-performance-budgets.mjs",
    "audit:structure": "node scripts/check-structure.mjs",
    "audit:dependencies": "npm audit --omit=optional",
    "audit:assets": "node scripts/report-asset-sizes.mjs public",
    "audit:provenance": "node skills/house-adel-design-guardian/scripts/report_images_without_provenance.mjs",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "analyze:bundle": "npm run build",
    "assets:fetch": "node --experimental-strip-types scripts/fetch-open-access-assets.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "libphonenumber-js": "1.13.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.84.0",
    "three": "0.182.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "fast-glob": "^3.3.3",
    "globals": "16.5.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}

{
  "name": "house-adel-direction-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 research, prototypes, and creative-direction review for House Adel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:serve": "node scripts/serve-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "measure:runtime": "node scripts/measure-runtime.mjs",
    "audit:structure": "node scripts/check-structure.mjs",
    "audit:dependencies": "npm audit --omit=optional",
    "audit:assets": "node scripts/report-asset-sizes.mjs public",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
